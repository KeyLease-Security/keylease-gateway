{
  "name": "@keylease/cli",
  "version": "0.1.0",
  "description": "KeyLease developer CLI: acquire on-chain Soroban API leases and mint session bearer tokens.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "keylease": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./token": {
      "types": "./dist/token.d.ts",
      "default": "./dist/token.js"
    },
    "./soroban": {
      "types": "./dist/client/soroban.d.ts",
      "default": "./dist/client/soroban.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^13.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.0.0"
  }
}
